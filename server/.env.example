# Copy to .env and fill in. Never commit .env.

# USDA FoodData Central key from https://fdc.nal.usda.gov/api-key-signup
# Without it the server uses a small offline food table (fixtures).
FDC_API_KEY=

# Amazon Bedrock. Credentials come from the standard AWS chain (aws configure, env vars or an IAM role).
AWS_REGION=us-east-1
# Ordered, comma-separated. Later models are used if earlier ones are not enabled for the account.
BEDROCK_MODEL_IDS=us.anthropic.claude-sonnet-4-6,us.amazon.nova-pro-v1:0
# Set to 0 to skip Bedrock and use the deterministic rule-based parser.
USE_BEDROCK=1

# DynamoDB table. Leave empty to use the in-memory store.
TABLE_NAME=

# Local server
PORT=3000
HOST=127.0.0.1
# Bearer token for the seeded demo user when running locally.
DEMO_TOKEN=demo-judge-token
LOG_LEVEL=info
